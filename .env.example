# Copy to .env and fill in before `docker compose up`.
# The compose file refuses to start without these.

POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-64-random-chars-run-openssl-rand-hex-32
ADMIN_INITIAL_PASSWORD=change-me-admin-password

# Where the browser reaches nginx (CORS allow-origin + token assumptions)
FRONTEND_ORIGIN=http://localhost:8080
WEB_PORT=8080

# true = also import the synthetic demo dataset (delete later via batch delete)
SEED_DEMO_DATA=true
